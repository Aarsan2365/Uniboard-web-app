PORT=5000
NODE_ENV=development

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://YOUR_DATABASE_USERNAME:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/uniboard?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/uniboard

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173

# Netlify defaults to mongodb; local development can use either mode.
UPLOAD_STORAGE=local
